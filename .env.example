# One environment file for the whole workspace. Copy it and fill in the blanks:
#
#   cp .env.example .env
#
# Both apps read this file through scripts/with-env.mjs, so there are no
# per-app .env files. Variables already set in your shell win over the ones
# below.

# --- apps/backend (NestJS) ---

# Port the API listens on.
PORT=4000

# --- apps/web (Next.js) ---

# Base URL the frontend calls. NEXT_PUBLIC_* values are inlined into the
# bundle at build time, so change this before `pnpm build`, not after.
NEXT_PUBLIC_API_URL=http://localhost:4000
